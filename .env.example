# 复制为 .env 后填写。.env 已被 .gitignore 排除，禁止提交真实值。
# Docker Compose 读取本文件同目录的 .env。

# 数据库
# 应用在容器内通过 compose 服务名 db 访问 MySQL，不要改成 localhost。
DB_HOST=db
DB_PORT=3306
DB_NAME=recycle
DB_USER=recycle
DB_PASSWORD=

# MySQL root 密码（仅在首次创建数据卷时使用）
MYSQL_ROOT_PASSWORD=

# 宿主机调试端口，仅绑定 127.0.0.1，供 Navicat / DataGrip 连接
MYSQL_HOST_PORT=3306

# JWT
JWT_SECRET=请替换为随机长字符串
JWT_EXPIRE_MINUTES=120

# 文件上传 / OSS
UPLOAD_DIR=./uploads
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
