            ],
            "body": {"mode": "raw", "raw": "{\"name\": \"环保布袋\", \"description\": \"可重复使用的环保购物袋\", \"pointsPrice\": 100, \"stock\": 50, \"spec\": \"40x35cm\", \"exchangeNotice\": \"请至站点领取\"}"},
