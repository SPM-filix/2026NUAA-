          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('新增商品成功', () => { pm.response.to.have.status(200); const j = pm.response.json(); pm.expect(j.code).to.eq(0); pm.expect(j.data.productId).to.be.a('number'); pm.environment.set('productId', j.data.productId); });"
