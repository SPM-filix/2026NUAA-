      "item": [
        {
          "name": "API-SYS-01 健康检查",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "pm.test('状态 UP', () => { const j = pm.response.json(); pm.expect(j.code).to.eq(0); pm.expect(j.data.status).to.eq('UP'); });"
              ],
              "type": "text/javascript"
            }
          }]
        }
      ]
    },
